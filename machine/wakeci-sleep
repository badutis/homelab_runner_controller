#!/usr/bin/env bash
# Suspends this machine unless a job is running on it. Only the controller runs it, over an
# SSH key that authorized_keys restricts to this one command; sudoers allows it without a
# password. Exit codes: wakeci/actions.py SLEEP_EXIT.
set -euo pipefail

# This check decides, not the GitHub API: the API reports a busy runner late.
if pgrep -f 'Runner.Worker' >/dev/null; then
  echo "busy: Runner.Worker is running" >&2
  exit 3
fi

# Scheduled 5 s ahead, so the SSH session can end cleanly.
if [ -f /var/run/reboot-required ]; then
  systemd-run --quiet --on-active=5 /usr/bin/systemctl reboot
  exit 4
fi
systemd-run --quiet --on-active=5 /usr/bin/systemctl suspend
exit 0
