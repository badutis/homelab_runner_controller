[Unit]
Description=Rack controller: wakes CI machines for queued jobs, suspends idle ones
After=network-online.target
Wants=network-online.target

[Service]
User=rackctl
Group=rackctl
WorkingDirectory=/opt/rackctl
ExecStart=/usr/bin/python3 -m rackctl /etc/rackctl/config.json
Restart=always
RestartSec=10
StateDirectory=rackctl
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
