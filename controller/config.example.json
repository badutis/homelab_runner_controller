{
  "$schema": "https://raw.githubusercontent.com/badutis/wakeci/main/docs/config.schema.json",
  "config_version": 1,
  "dry_run": true,
  "poll_seconds": 20,
  "idle_minutes": 30,
  "broadcast": "192.0.2.255",
  "metrics_listen": "0.0.0.0:9105",
  "state_file": "/var/lib/wakeci/last-online.json",
  "ssh_key": "/etc/wakeci/id_ed25519",
  "known_hosts": "/etc/wakeci/known_hosts",
  "notify": {
    "url_file": "/etc/wakeci/notify-url",
    "format": "discord",
    "after_minutes": 10,
    "repeat_hours": 6
  },
  "sources": [
    {
      "runners_path": "repos/example-org/app",
      "repos": [
        "example-org/app"
      ],
      "token_file": "/etc/wakeci/token-example-org"
    },
    {
      "runners_path": "orgs/example-org2",
      "repos": [
        "example-org2/repo-a",
        "example-org2/repo-b"
      ],
      "token_file": "/etc/wakeci/token-example-org2"
    }
  ],
  "machines": [
    {
      "name": "host1",
      "mac": "00:00:5e:00:53:01",
      "host": "192.0.2.11",
      "ssh_user": "wakeci",
      "runner_prefixes": [
        "host1-a-",
        "host1-b-"
      ],
      "rank": 1
    },
    {
      "name": "host2",
      "mac": "00:00:5e:00:53:02",
      "host": "192.0.2.12",
      "ssh_user": "wakeci",
      "runner_prefixes": [
        "host2-a-"
      ],
      "rank": 1
    },
    {
      "name": "host3",
      "mac": "00:00:5e:00:53:03",
      "host": "192.0.2.13",
      "ssh_user": "wakeci",
      "runner_prefixes": [
        "host3-a-"
      ],
      "rank": 2
    }
  ]
}
