#!/usr/bin/env bash
# Git pre-push hook, installed by scripts/install-hooks.sh. Runs scripts/public_safe.py over
# the history of every commit about to be pushed and refuses the push if it finds anything,
# so installation data never reaches the public repository. CI runs the same check, but only
# after the push, when it is already public.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
guard="$root/scripts/public_safe.py"
if [ ! -f "$guard" ]; then
  echo "pre-push: $guard not found; push refused (check out a branch that has it)" >&2
  exit 1
fi

failed=0
# git passes one line per ref: <local ref> <local sha> <remote ref> <remote sha>. The sha
# may be a commit or a tag object; the guard checks what that one object brings.
while read -r local_ref local_sha _remote_ref _remote_sha; do
  [[ "$local_sha" =~ ^0+$ ]] && continue  # deleting a remote ref: nothing to check
  rc=0
  (cd "$root" && python3 "$guard" --history --rev "$local_sha" </dev/null >&2) || rc=$?
  case "$rc" in
    0) ;;
    1) echo "pre-push: $local_ref ($local_sha) holds the findings above; push refused" >&2; failed=1 ;;
    *) echo "pre-push: the guard could not check $local_ref (exit $rc: see the error above;" \
            "on a branch with an older scripts/public_safe.py, update it or check out one with" \
            "the current guard); push refused." >&2
       failed=1 ;;
  esac
done
exit "$failed"
